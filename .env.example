# Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example is committed.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Get this from your local PostgreSQL instance or a managed provider.
# DATABASE_URL="postgresql://user:password@localhost:5432/authslice"

# Node environment
# NODE_ENV="development"

# Public app URL (used in password-reset email links)
# APP_URL="http://localhost:3000"

# SMTP (optional — when unset, Ethereal test accounts are used in development)
# To use a real mail server, fill these in and the app will use them.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_FROM="AuthSlice <noreply@example.com>"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
